---
import ScreenshotPlaceholder from './ScreenshotPlaceholder.astro';

interface Props {
	id: string;
	title: string;
	description: string;
	screenshot: string | null;
	label: string;
	alt: string;
	highlights?: readonly string[];
	reverse?: boolean;
	priority?: boolean;
}

const {
	id,
	title,
	description,
	screenshot,
	label,
	alt,
	highlights = [],
	reverse = false,
	priority = false,
} = Astro.props;
---

<section class:list={['feature', reverse && 'feature--reverse']} id={id}>
	<div class="container feature__grid">
		<div class="feature__copy">
			<h2>{title}</h2>
			<p>{description}</p>
		</div>
		<div class="feature__media">
			{
				screenshot ? (
					<ScreenshotPlaceholder filename={screenshot} label={label} alt={alt} priority={priority} />
				) : (
					<div class="feature__panel" role="img" aria-label={alt}>
						<p>{label}</p>
						<ul>
							{highlights.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.feature {
		padding: 4.5rem 0;
	}

	.feature__grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.feature__copy {
		display: grid;
		gap: 0.9rem;
		max-width: 34rem;
	}

	.feature__copy h2 {
		font-size: clamp(1.8rem, 3.4vw, 2.6rem);
	}

	.feature__copy p {
		color: var(--text-muted);
		font-size: 1.05rem;
	}

	.feature__media {
		display: flex;
		justify-content: center;
	}

	.feature__panel {
		width: min(100%, 410px);
		padding: clamp(1.5rem, 4vw, 2.4rem);
		border: 1px solid rgba(255, 255, 255, 0.13);
		border-radius: 26px;
		background: linear-gradient(145deg, rgba(255, 159, 67, 0.11), rgba(199, 109, 255, 0.09));
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
	}

	.feature__panel > p {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
	}

	.feature__panel ul {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.feature__panel li {
		padding: 0.55rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.05);
		font-size: 0.88rem;
		font-weight: 650;
	}

	@media (min-width: 880px) {
		.feature__grid {
			grid-template-columns: 1.05fr 0.95fr;
			gap: 3.5rem;
		}

		.feature--reverse .feature__grid {
			grid-template-columns: 0.95fr 1.05fr;
		}

		.feature--reverse .feature__copy {
			order: 2;
		}

		.feature--reverse .feature__media {
			order: 1;
		}
	}
</style>

---
import ScreenshotPlaceholder from './ScreenshotPlaceholder.astro';
import { siteConfig } from '../data/site';

const appStoreUrl = siteConfig.appStoreUrl;
---

<section class="hero">
	<div class="container hero__grid">
		<div class="hero__copy">
			<p class="hero__brand">{siteConfig.name}</p>
			<h1>Your private media vault, on device.</h1>
			<p class="hero__lede">
				Import local video and audio, organize playlists, play in the background, and run
				lightweight tools — without an account or cloud upload.
			</p>
			<div class="hero__actions">
				{
					appStoreUrl ? (
						<a class="btn btn-primary" href={appStoreUrl}>
							Download on the App Store
						</a>
					) : (
						<a class="btn btn-primary" href={siteConfig.legal.support}>
							Get support
						</a>
					)
				}
				<a class="btn btn-secondary" href="#features">See features</a>
			</div>
		</div>
		<div class="hero__visual" aria-hidden={false}>
			<ScreenshotPlaceholder
				filename="library.png"
				label="Library Screenshot"
				alt="VideoVault library screenshot"
				priority
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: 3.5rem 0 2rem;
		overflow: clip;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 8% -20% auto;
		height: 55%;
		background:
			radial-gradient(ellipse at center, rgba(62, 200, 255, 0.16), transparent 65%);
		pointer-events: none;
		z-index: -1;
	}

	.hero__grid {
		display: grid;
		gap: 2.75rem;
		align-items: center;
		min-height: min(78vh, 720px);
	}

	.hero__copy {
		display: grid;
		gap: 1.15rem;
		max-width: 36rem;
		animation: rise-in 0.7s ease both;
	}

	.hero__brand {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.1rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		background: linear-gradient(120deg, #eff8ff 10%, var(--accent) 55%, #b8a6ff 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__copy h1 {
		font-size: clamp(1.55rem, 3.2vw, 2.15rem);
		font-weight: 700;
		color: var(--text);
		max-width: 18ch;
	}

	.hero__lede {
		color: var(--text-muted);
		font-size: 1.08rem;
		max-width: 38ch;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.35rem;
	}

	.hero__visual {
		display: flex;
		justify-content: center;
		animation:
			rise-in 0.85s ease 0.12s both,
			float-soft 7s ease-in-out 1s infinite;
	}

	@media (min-width: 900px) {
		.hero__grid {
			grid-template-columns: 1.1fr 0.9fr;
			gap: 2rem;
		}

		.hero__visual {
			justify-content: flex-end;
		}
	}
</style>

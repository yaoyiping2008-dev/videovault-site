---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
	filename: string;
	label: string;
	alt: string;
	priority?: boolean;
}

const { filename, label, alt, priority = false } = Astro.props;
const filePath = path.join(process.cwd(), 'public', 'screenshots', filename);
const hasImage = fs.existsSync(filePath);
const src = `/screenshots/${filename}`;
---

<figure class="phone">
	{
		hasImage ? (
			<img
				class="phone__image"
				src={src}
				alt={alt}
				width="1320"
				height="2868"
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : 'auto'}
				decoding="async"
			/>
		) : (
			<div class="phone__placeholder" role="img" aria-label={alt}>
				<span class="phone__label">{label}</span>
				<span class="phone__hint">/screenshots/{filename}</span>
			</div>
		)
	}
</figure>

<style>
	.phone {
		margin: 0;
		width: min(100%, 280px);
		aspect-ratio: var(--phone-ratio);
		border-radius: var(--radius-phone);
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.14);
		background:
			linear-gradient(165deg, rgba(62, 200, 255, 0.12), transparent 42%),
			linear-gradient(345deg, rgba(139, 108, 255, 0.14), transparent 40%),
			var(--bg-elevated);
		box-shadow:
			0 30px 60px rgba(0, 0, 0, 0.35),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.phone__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.phone__placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		place-content: center;
		gap: 0.55rem;
		padding: 1.5rem;
		text-align: center;
		background:
			repeating-linear-gradient(
				-12deg,
				transparent,
				transparent 11px,
				rgba(255, 255, 255, 0.02) 11px,
				rgba(255, 255, 255, 0.02) 12px
			);
	}

	.phone__label {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.phone__hint {
		font-size: 0.72rem;
		color: var(--text-muted);
		word-break: break-all;
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeatureSection from '../components/FeatureSection.astro';
import { features, siteConfig } from '../data/site';
import { articlePath, seoArticles } from '../data/seo-articles';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: siteConfig.name,
	applicationCategory: 'MultimediaApplication',
	operatingSystem: 'iOS, iPadOS',
	description: siteConfig.description,
	offers: [
		{
			'@type': 'Offer',
			name: 'VideoVault Pro Monthly',
			price: '0.99',
			priceCurrency: 'USD',
		},
		{
			'@type': 'Offer',
			name: 'VideoVault Pro Yearly',
			price: '9.99',
			priceCurrency: 'USD',
		},
	],
};
---

<Layout>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<Hero />

	<section class="privacy-band" aria-label="Privacy promise">
		<div class="container">
			<h2>Files stay on your device</h2>
			<p>
				VideoVault does not require an account and does not upload your videos, audio, Private Lists,
				or backups to a developer-operated server.
			</p>
		</div>
	</section>

	<div id="features" aria-label="VideoVault features">
		{
			features.map((feature, index) => (
				<FeatureSection
					id={feature.id}
					title={feature.title}
					description={feature.description}
					screenshot={feature.screenshot}
					label={feature.label}
					alt={feature.alt}
					highlights={'highlights' in feature ? feature.highlights : undefined}
					reverse={index % 2 === 1}
					priority={index === 0}
				/>
			))
		}
	</div>

	<section class="platform" aria-labelledby="platform-heading">
		<div class="container platform__grid">
			<div>
				<p class="section-kicker">A workspace that feels like yours</p>
				<h2 id="platform-heading">Four themes. More room on iPad.</h2>
				<p>
					Choose the appearance that suits your media, then move comfortably between Player,
					Video Studio, Audio Tools, Web Import, and Private Lists. VideoVault 1.0.4 is
					optimized for both iPhone and iPad layouts.
				</p>
			</div>
			<div class="theme-showcase" aria-label="Four appearance themes">
				<div class="theme-swatches" aria-hidden="true">
					<span class="theme-dot theme-dot--pearl"></span>
					<span class="theme-dot theme-dot--midnight"></span>
					<span class="theme-dot theme-dot--sunset"></span>
					<span class="theme-dot theme-dot--ocean"></span>
				</div>
				<strong>Four appearance themes</strong>
				<span>Choose the look that works for your space and media.</span>
			</div>
		</div>
	</section>

	<section class="guides" id="guides" aria-labelledby="guides-heading">
		<div class="container guides__inner">
			<h2 id="guides-heading">Guides</h2>
			<p>Practical how-tos for focused playback, video editing, audio tools, and private media organization.</p>
			<ul class="guides__list">
				{
					seoArticles.map((article) => (
						<li>
							<a href={articlePath(article.slug)}>{article.title}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="pro" id="pro" aria-labelledby="pro-heading">
		<div class="container pro__inner">
			<p class="section-kicker">VideoVault Pro</p>
			<h2 id="pro-heading">Choose the plan that fits</h2>
			<p>
				Unlock advanced playback, Video Studio, Audio Tools, and the complete media workflow.
				Prices below are in USD; the App Store shows the final local price before purchase.
			</p>
			<div class="pricing" aria-label="VideoVault Pro plans">
				<article class="price-card">
					<h3>Monthly</h3>
					<p class="price"><strong>$0.99</strong><span>/ month</span></p>
					<p>Eligible new Monthly subscribers may receive a 7-day free trial.</p>
				</article>
				<article class="price-card">
					<h3>Yearly</h3>
					<p class="price"><strong>$9.99</strong><span>/ year</span></p>
					<p>One annual payment for continued access to Pro features.</p>
				</article>
				<article class="price-card price-card--featured">
					<p class="price-card__badge">One-time option</p>
					<h3>Lifetime Pro</h3>
					<p class="price"><strong>Lifetime Pro</strong><span>— one-time purchase</span></p>
					<p>The App Store shows the current price before purchase.</p>
				</article>
			</div>
			<ul class="pro__features">
				<li>A-B Repeat, Video Bookmarks, background playback, and Picture in Picture</li>
				<li>Video Studio with Trim, Crop, 9:16, Text, Logo, and Hide Area</li>
				<li>Audio extraction, background music, volume adjustment, and recording</li>
				<li>Restore eligible purchases or subscriptions with your Apple Account</li>
			</ul>
			{
				siteConfig.appStoreUrl ? (
					<a class="btn btn-primary" href={siteConfig.appStoreUrl}>
						Get VideoVault
					</a>
				) : (
					<a class="btn btn-primary" href={`mailto:${siteConfig.email}?subject=VideoVault%20Inquiry`}>
						Contact us
					</a>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.privacy-band {
		padding: 3rem 0;
		border-block: 1px solid var(--line);
		background: linear-gradient(180deg, rgba(255, 159, 67, 0.07), transparent);
	}

	.privacy-band h2 {
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		margin-bottom: 0.65rem;
	}

	.privacy-band p {
		max-width: 42rem;
		color: var(--text-muted);
	}

	.guides {
		padding: 3.5rem 0 1rem;
	}

	.platform {
		padding: 4.5rem 0 2rem;
	}

	.platform__grid {
		display: grid;
		gap: 2rem;
		align-items: center;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--line);
		border-radius: 28px;
		background: linear-gradient(135deg, rgba(255, 159, 67, 0.09), rgba(199, 109, 255, 0.08));
	}

	.platform h2 { font-size: clamp(1.8rem, 3.2vw, 2.65rem); margin: 0.35rem 0 0.8rem; }
	.platform p { color: var(--text-muted); max-width: 44rem; }
	.section-kicker { color: var(--accent); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.78rem; }
	.theme-showcase { display: grid; gap: .55rem; }
	.theme-showcase > span { color: var(--text-muted); font-size: .9rem; }
	.theme-swatches { display: flex; gap: .7rem; margin-bottom: .25rem; }
	.theme-dot { width: 2.1rem; height: 2.1rem; border: 2px solid rgba(255,255,255,.22); border-radius: 50%; flex: 0 0 auto; }
	.theme-dot--pearl { background: #f4f1eb; }
	.theme-dot--midnight { background: #171624; }
	.theme-dot--sunset { background: linear-gradient(135deg, #ff8a3d, #cb4d9b); }
	.theme-dot--ocean { background: linear-gradient(135deg, #25b8d7, #315dc2); }

	.guides__inner {
		display: grid;
		gap: 0.75rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line);
	}

	.guides__inner h2 {
		font-size: clamp(1.5rem, 2.8vw, 2rem);
	}

	.guides__inner > p {
		color: var(--text-muted);
		max-width: 40rem;
	}

	.guides__list {
		list-style: none;
		margin: 0.6rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.guides__list a {
		color: var(--text);
		text-decoration: none;
		font-weight: 600;
	}

	.guides__list a:hover {
		color: var(--accent);
	}

	.pro {
		padding: 4.5rem 0 2rem;
	}

	.pro__inner {
		display: grid;
		gap: 1rem;
		padding: 2.4rem 0;
		border-top: 1px solid var(--line);
		animation: rise-in 0.7s ease both;
	}

	.pro__inner h2 {
		font-size: clamp(1.8rem, 3.2vw, 2.45rem);
	}

	.pro__inner > p {
		max-width: 40rem;
		color: var(--text-muted);
	}

	.pro__features {
		margin: 0.4rem 0 0.8rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
		max-width: 36rem;
	}

	.pro__features li {
		position: relative;
		padding-left: 1.2rem;
		color: var(--text);
	}

	.pro__features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--accent);
	}

	.pro__inner .btn {
		justify-self: start;
		margin-top: 0.35rem;
	}

	.pricing { display: grid; gap: 1rem; margin: 0.8rem 0; }
	.price-card { position: relative; display: grid; align-content: start; gap: 0.65rem; padding: 1.4rem; border: 1px solid var(--line); border-radius: 20px; background: rgba(255,255,255,.035); }
	.price-card--featured { border-color: rgba(255,159,67,.55); background: linear-gradient(145deg, rgba(255,159,67,.12), rgba(199,109,255,.08)); }
	.price-card h3 { font-size: 1.15rem; }
	.price-card p { color: var(--text-muted); }
	.price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.4rem; }
	.price strong { color: var(--text); font-family: var(--font-display); font-size: 2rem; }
	.price-card__badge { color: var(--accent) !important; font-size: .76rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }

	@media (min-width: 760px) {
		.platform__grid { grid-template-columns: 1.35fr .65fr; }
		.pricing { grid-template-columns: repeat(3, 1fr); }
	}
</style>
